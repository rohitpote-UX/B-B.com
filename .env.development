# Brand Battle - Development Environment
ENV=development
DEBUG=true
APP_NAME="Brand Battle (Dev)"
APP_VERSION="1.0.0"

# Local SQLite / PostgreSQL
DATABASE_URL=sqlite:///./brandbattle.db
POSTGRES_USER=brandbattle
POSTGRES_PASSWORD=brandbattle_dev_secret
POSTGRES_DB=brandbattle_dev
POSTGRES_HOST=
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_ENABLED=true
RATE_LIMIT_PER_MINUTE=240

# JWT & Security
SECRET_KEY=brand-battle-dev-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
