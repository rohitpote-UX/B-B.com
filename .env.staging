# Brand Battle - Staging Environment
ENV=staging
DEBUG=false
APP_NAME="Brand Battle (Staging)"
APP_VERSION="1.0.0"

# Staging PostgreSQL
POSTGRES_USER=brandbattle_staging
POSTGRES_PASSWORD=brandbattle_staging_pass_2026
POSTGRES_DB=brandbattle_staging_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brandbattle_staging:brandbattle_staging_pass_2026@postgres:5432/brandbattle_staging_db

# Staging Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# JWT & Security
SECRET_KEY=brand-battle-staging-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=staging.brandbattle.com,localhost
CORS_ORIGINS=https://staging.brandbattle.com,http://localhost:3000
