# Brand Battle - Environment Template
ENV=production
DEBUG=false
APP_NAME="Brand Battle"
APP_VERSION="1.0.0"

# PostgreSQL Configuration
POSTGRES_USER=brandbattle
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=brandbattle_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brandbattle:your_secure_postgres_password@postgres:5432/brandbattle_db

# Redis Caching & Celery Broker
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# JWT Authentication
SECRET_KEY=generate_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
ALLOWED_HOSTS=brandbattle.in,www.brandbattle.in,api.brandbattle.in,localhost
CORS_ORIGINS=http://localhost:3000,https://brandbattle.in,https://www.brandbattle.in

# External APIs (Optional)
OPENAI_API_KEY=
DUMMYJSON_BASE_URL=https://dummyjson.com

# ─── Frontend (Next.js) Environment Variables ─────────────────────────────────
# Copy these into frontend-next/.env.local for local development
# For Vercel production: set in Vercel Project Settings → Environment Variables

# FastAPI backend URL — controls all backend API calls (Axios client + rewrite proxy)
# Local dev:  http://localhost:8000
# Production: https://b-b-com.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public-facing frontend URL (used for SEO canonical URLs and Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000
