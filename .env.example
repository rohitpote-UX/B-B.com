# Brand Battle - Environment Template
ENV=production
DEBUG=false
APP_NAME="Brand Battle"
APP_VERSION="1.0.0"

# PostgreSQL Configuration
POSTGRES_USER=brandbattle
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=brandbattle_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brandbattle:your_secure_postgres_password@postgres:5432/brandbattle_db

# Redis Caching & Celery Broker
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# JWT Authentication
SECRET_KEY=generate_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
ALLOWED_HOSTS=brandbattle.com,www.brandbattle.com,localhost
CORS_ORIGINS=http://localhost:3000,https://brandbattle.com,https://www.brandbattle.com

# External APIs (Optional)
OPENAI_API_KEY=
DUMMYJSON_BASE_URL=https://dummyjson.com
