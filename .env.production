# Brand Battle - Production Environment
ENV=production
DEBUG=false
APP_NAME="Brand Battle"
APP_VERSION="1.0.0"

# Production PostgreSQL
POSTGRES_USER=brandbattle_prod
POSTGRES_PASSWORD=brandbattle_prod_secret_key_998877
POSTGRES_DB=brandbattle_prod_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brandbattle_prod:brandbattle_prod_secret_key_998877@postgres:5432/brandbattle_prod_db

# Production Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# JWT & Security
SECRET_KEY=prod_jwt_super_secret_key_brand_battle_2026_x
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=brandbattle.com,www.brandbattle.com,backend
CORS_ORIGINS=https://brandbattle.com,https://www.brandbattle.com,http://localhost:3000
